{
  "name": "bun-relay",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/server dev",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "db:seed": "bun run --cwd apps/server db:seed",
    "start": "bun run --cwd apps/server start",
    "typecheck": "bun run --cwd apps/server typecheck && bun x tsc -p packages/shared/tsconfig.json --noEmit",
    "test": "bun run --cwd apps/server test",
    "test:ui-smoke": "node scripts/ui-smoke.mjs",
    "ci": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  }
}
