# Server runtime
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# Database
# sqlite (default):
DB_DRIVER=sqlite
DB_URL=apps/server/data/dev.sqlite
# postgres example:
# DB_DRIVER=postgres
# DB_URL=postgres://bunrelay:bunrelay@localhost:5432/bunrelay

# Auth
# Use at least 32 chars in real environments.
JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# Operational limits
HTTP_MAX_BODY_BYTES=16384
WS_MAX_MESSAGE_BYTES=16384
WS_RATE_LIMIT_PER_SEC=50
WS_AUTH_TIMEOUT_MS=5000
WS_HEARTBEAT_TIMEOUT_MS=45000
MESSAGE_MAX_CHARS=4000
