# Server runtime
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# Database
# sqlite (default):
DB_DRIVER=sqlite
DB_URL=apps/server/data/dev.sqlite
# postgres example:
# DB_DRIVER=postgres
# DB_URL=postgres://bunrelay:bunrelay@localhost:5432/bunrelay

# Redis (optional, enables multi-instance pub/sub)
# REDIS_URL=redis://localhost:6379

# Auth
# Use at least 32 chars in real environments.
JWT_SECRET=change-this-secret-with-at-least-32-characters
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# Operational limits
HTTP_MAX_BODY_BYTES=16384
WS_MAX_MESSAGE_BYTES=16384
WS_RATE_LIMIT_PER_SEC=50
WS_AUTH_TIMEOUT_MS=5000
WS_HEARTBEAT_TIMEOUT_MS=45000
MESSAGE_MAX_CHARS=4000

# Distributed tracing (OTLP/HTTP)
# Enable tracing and optionally export spans to an OTLP HTTP endpoint.
TRACING_ENABLED=false
TRACING_SERVICE_NAME=bunrelay-server
# Example:
# TRACING_OTLP_HTTP_URL=http://localhost:4318/v1/traces
TRACING_OTLP_HTTP_URL=
# Example headers format: key=value,key2=value2
TRACING_OTLP_HEADERS=
TRACING_SAMPLING_RATIO=1
TRACING_EXPORT_BATCH_SIZE=64
TRACING_EXPORT_INTERVAL_MS=5000
TRACING_EXPORT_TIMEOUT_MS=2500

# External log sinks (generic HTTP JSON batch POST)
# Comma-separated list of sink URLs.
LOG_SINK_HTTP_URLS=
# Headers format: key=value,key2=value2
LOG_SINK_HTTP_HEADERS=
LOG_SINK_BATCH_SIZE=100
LOG_SINK_FLUSH_INTERVAL_MS=2000
LOG_SINK_TIMEOUT_MS=2500
LOG_SINK_BUFFER_MAX=2000
